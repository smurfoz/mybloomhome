# PostgreSQL 16 database for the app
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store_dev
# Public origin printed into QR labels. Set it in production so labels never
# depend on the request's Host header. HTTPS is required for the phone camera.
APP_URL=https://store.example.com
# Used by `npm run db:seed` for all demo users (a random one is printed if unset)
SEED_PASSWORD=
# Tests create and drop their own databases through this connection
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
